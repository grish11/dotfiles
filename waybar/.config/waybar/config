{
  "layer": "bottom",
  "position": "top",
  "height": 30,
  "spacing": 5,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["network", "cpu", "memory","pulseaudio", "battery", "custom/power","tray"],

  "hyprland/workspaces": {
      "format": "{name}{icon}",
      "on-click": "activate",
      "format-icons": {
          "active": "*",
          "default": ""
      }
  },

  "network": {
      "format": "[<b>wifi</b>:{essid} {signalStrength}% /"
  },

  "cpu": {
      "format": "<b>cpu</b>:{usage}% /"
  },

  "memory": {
      "format": "<b>ram</b>:{percentage}% /"
  },

  "clock": {
      "format": "{:%I:%M %p}",
      "format-alt": "{:%Y-%m-%d}",
      "tooltip-format": "{calendar}"
  },

  "pulseaudio": {
      "format": "<b>vol</b>:{volume}% /",
      "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
      "on-click-right": "pavucontrol"
  },

  "battery": {
      "format": "<b>bat:</b>{capacity}%]",
      "format-charging": "<b>bat:</b>+{capacity}%]"
  },

  "tray": {
      "icon-size": 20,
      "spacing": 8
  }

}


